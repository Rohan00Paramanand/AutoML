# ─────────────────────────────────────────────────────────────
# AutoML Workbench — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Google Gemini API Key ─────────────────────────────────────
# Required for the Gemini AI provider.
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=""

# ── CORS Allowed Origins ──────────────────────────────────────
# Comma-separated list of origins that may call the backend.
# In production, replace with your actual frontend URL.
# Example: ALLOWED_ORIGINS="https://automl.yourdomain.com"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8501"

# ── Server Host & Port ────────────────────────────────────────
# Default: 0.0.0.0:8000 (all interfaces, port 8000)
# HOST=0.0.0.0
# PORT=8000
